# ============================================================================
# Makefile.x86_64 — сборка 64-битного скелета AMPLIFY-OS (этап 37.1).
# ----------------------------------------------------------------------------
# Подключается из главного Makefile при ARCH=x86_64. Изолированный набор
# исходников, флагов и QEMU-целей. НЕ ТРОГАЕТ i386-путь.
# ============================================================================

# Явно: default goal = all (иначе make подцепит первое явное правило, которое
# окажется $(USER_BUILD)/hello.o из секции userspace ниже).
.DEFAULT_GOAL := all

ASM       := nasm
CC        := gcc
LD        := ld
QEMU      := qemu-system-x86_64
GRUB_MKR  := grub-mkrescue
GRUB_PC_DIR := /usr/lib/grub/i386-pc

BUILD_DIR := build/x86_64
ISO_DIR   := build/iso-x86_64
KERNEL    := build/kernel-x86_64.bin
ISO       := build/myos-x86_64.iso
# Этап 57: BOOTEFI объявлен здесь, а не рядом с целью esp, потому что его
# использует список prerequisite'ов initrd (payload установщика).  Список
# prerequisite'ов раскрывается в момент чтения правила — переменная,
# объявленная ниже по файлу, в нём оказалась бы пустой (см. CLAUDE.md §14.13).
BOOTEFI   := build/uefi/BOOTX64.EFI

# x86_64 freestanding флаги.
# -mno-red-zone   — обязательно для kernel-mode (иначе исключение нарушит данные).
# -mcmodel=kernel — эффективные адреса в верхней half (хотя пока линкуем в нижнюю).
# [этап 44] -mmmx -msse -msse2 НЕ выключаем: ядро теперь включает FPU+SSE
#                 в boot.asm (CR4.OSFXSR | CR4.OSXMMEXCPT, FNINIT, LDMXCSR),
#                 а task_yield + isr_common + syscall_entry делают FXSAVE/
#                 FXRSTOR.  GCC свободен использовать xmm регистры в любых
#                 файлах ядра, включая 3D-рендер GLES.
# -finput-charset=UTF-8 -fexec-charset=CP1251 — исходники у нас в UTF-8 (так удобно
#   редактировать), но во время компиляции GCC перекодирует все строковые
#   литералы в CP1251 (по 1 байту на символ), чтобы 8×16 bitmap-шрифт мог
#   рисовать кириллицу напрямую через индексирование по байту.  Этот же
#   приём уже используется в основном Makefile (i386), здесь его не хватало.
ARCH_CFLAGS = -m64 -ffreestanding -fno-stack-protector -fno-pie \
               -mno-red-zone -mcmodel=kernel \
               -nostdlib -fno-builtin -Wall -Wextra -O2 \
               -finput-charset=UTF-8 -fexec-charset=CP1251 \
               -Ikernel $(HH_CFLAGS) $(CFLAGS_EXTRA)

ARCH_ASMFLAGS := -felf64

# ----------------------------------------------------------------------------
# [38.1.1] Раскладка ядра.
#   HIGHER_HALF=1 (по умолчанию) — ядро слинковано в верхней половине адресов
#       (linker_x86_64.ld, boot.asm), загрузчик UEFI кладёт его куда угодно.
#   HIGHER_HALF=0 — прежняя раскладка: ядро по физическому адресу 1 МБ
#       (linker_x86_64_low.ld, boot_low.asm). Оставлена как путь отката до
#       конца подэтапа 38.1. Переключение — ТОЛЬКО с чистой сборкой
#       (rm -rf build/x86_64/kernel): объектные файлы у раскладок разные.
#
# KERNEL_END_LIMIT — предел конца образа в адресах ЗАГРУЗКИ (см. правило
# $(KERNEL)); 0 — не проверять.
#   нижняя раскладка: 0x800000 — с этого адреса у OVMF лежит ACPI NVS;
#   верхняя: 0x1000000 — у пути UEFI стены больше нет, но GRUB по-прежнему
#       кладёт ядро с 1 МБ, а с 16 МБ начинается куча ядра (до 38.1.3).
# ----------------------------------------------------------------------------
HIGHER_HALF ?= 1
ifeq ($(HIGHER_HALF),1)
HH_CFLAGS        := -DAOS_HIGHER_HALF=1
KERNEL_LDSCRIPT  := linker_x86_64.ld
KERNEL_BOOT_ASM  := kernel/arch/x86_64/boot.asm
KERNEL_END_SYM   := _kernel_end_lma
KERNEL_END_LIMIT ?= 0x1000000
else
HH_CFLAGS        :=
KERNEL_LDSCRIPT  := linker_x86_64_low.ld
KERNEL_BOOT_ASM  := kernel/arch/x86_64/boot_low.asm
KERNEL_END_SYM   := _kernel_end
KERNEL_END_LIMIT ?= 0x800000
endif

ARCH_LDFLAGS  := -m elf_x86_64 -nostdlib -static \
                 -T $(KERNEL_LDSCRIPT) -z max-page-size=0x1000

# Источники.
ASM_SRC := \
    $(KERNEL_BOOT_ASM) \
    kernel/arch/x86_64/gdt_flush.asm \
    kernel/arch/x86_64/idt_flush.asm \
    kernel/arch/x86_64/isr.asm \
    kernel/arch/x86_64/smp_trampoline.asm \
    kernel/arch/x86_64/vmx_entry.asm \
    kernel/arch/x86_64/phantom_guest.asm \
    kernel/arch/x86_64/phantom_bios_rom.asm \
    kernel/arch/x86_64/syscall_entry.asm \
    kernel/arch/x86_64/user_mode.asm \
    kernel/arch/x86_64/user_test.asm \
    kernel/arch/x86_64/task_switch.asm

